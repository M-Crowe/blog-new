---
import type { ArtVolume, GalleryItem } from '../data/galleryItems';
import BookLightbox from './BookLightbox.astro';

interface Props {
  volumes?: ArtVolume[];
  volume?: ArtVolume;
  items?: GalleryItem[];
  showVolumeHeader?: boolean;
}

const { volumes, volume, items: propsItems, showVolumeHeader = true } = Astro.props;

const effectiveVolumes = volumes && volumes.length > 0
  ? volumes
  : (volume ? [volume] : []);

const allItems = propsItems || effectiveVolumes.flatMap((v) => v.items);

// 依据用户指定规则将相册切分为不同的行：
// 1个 -> 1行1个
// 2个 -> 1行2个
// 3个 -> 1行3个
// 4个 -> 2行，每行2个
// 5个 -> 上面1行2个，下面1行3个
const getVolumeRows = (items: GalleryItem[]): GalleryItem[][] => {
  const count = items.length;
  if (count <= 3) {
    return [items];
  }
  if (count === 4) {
    return [items.slice(0, 2), items.slice(2, 4)];
  }
  if (count === 5) {
    return [items.slice(0, 2), items.slice(2, 5)];
  }
  
  const rows: GalleryItem[][] = [];
  let idx = 0;
  while (idx < count) {
    const remaining = count - idx;
    if (remaining === 5) {
      rows.push(items.slice(idx, idx + 2));
      rows.push(items.slice(idx + 2, idx + 5));
      break;
    } else if (remaining === 4) {
      rows.push(items.slice(idx, idx + 2));
      rows.push(items.slice(idx + 2, idx + 4));
      break;
    } else if (remaining === 2) {
      rows.push(items.slice(idx, idx + 2));
      break;
    } else {
      const take = Math.min(3, remaining);
      rows.push(items.slice(idx, idx + take));
      idx += take;
    }
  }
  return rows;
};
---

<div class="artbook-spread-wrapper">
  {effectiveVolumes.map((vol) => {
    const rows = getVolumeRows(vol.items);

    return (
      <article class="volume-container" data-volume-id={vol.volId}>
        {showVolumeHeader && (
          <header class="artbook-prologue">
            <div class="prologue-spine">
              <span class="spine-badge">{vol.volNumber}</span>
              <span class="spine-edition">COLLECTION · {vol.year}</span>
            </div>
            <div class="prologue-main">
              <h2 class="prologue-title">{vol.title}</h2>
              <p class="prologue-subtitle">{vol.subtitle}</p>
              <div class="prologue-note">
                <p>{vol.curatorNote}</p>
              </div>
            </div>
            <div class="prologue-meta">
              <div class="meta-item">
                <span class="meta-label">收录作品</span>
                <span class="meta-value">{vol.items.length} 帧切片</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">装帧格式</span>
                <span class="meta-value">Lookbook Monograph</span>
              </div>
            </div>
          </header>
        )}

        <div class="artbook-gallery">
          {rows.map((row) => (
            <div class={`spread-row grid-${row.length}`}>
              {row.map((item) => (
                <article class="gallery-card" data-open-artbook={item.id}>
                  <div class="card-media">
                    <img src={item.image} alt={item.title} class="card-image" loading="lazy" />
                    <div class="card-hover-overlay">
                      <span class="hover-plate">{item.plateNumber}</span>
                      <span class="hover-action">展卷阅读 ↗</span>
                    </div>
                  </div>
                  <div class="card-info">
                    <div class="card-head">
                      <span class="card-num">{item.plateNumber}</span>
                      <span class="card-category">{item.category}</span>
                    </div>
                    <h3 class="card-title">{item.title}</h3>
                    {item.subtitle && <p class="card-desc">{item.subtitle}</p>}
                    <div class="card-meta">
                      <span>{item.place}</span>
                      <span>{item.dateLabel}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ))}
        </div>
      </article>
    );
  })}

  <!-- Fullscreen Book Lightbox -->
  <BookLightbox items={allItems} />
</div>

<style>
  .artbook-spread-wrapper {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .volume-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Prologue / Book Spine */
  .artbook-prologue {
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 16px;
    padding: 32px 36px;
    display: grid;
    grid-template-columns: 180px 1fr 180px;
    gap: 32px;
    align-items: start;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .prologue-spine {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spine-badge {
    display: inline-block;
    width: fit-content;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    background: #111;
    color: #fff;
    padding: 4px 10px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .spine-edition {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888;
    line-height: 1.4;
  }

  .prologue-main {
    border-left: 1px solid #f0f0f0;
    border-right: 1px solid #f0f0f0;
    padding: 0 32px;
  }

  .prologue-title {
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #1a1a1a;
    margin: 0 0 6px;
  }

  .prologue-subtitle {
    font-size: 0.88rem;
    color: #777;
    margin: 0 0 14px;
    letter-spacing: 0.02em;
  }

  .prologue-note p {
    font-size: 0.92rem;
    line-height: 1.7;
    color: #444;
    margin: 0;
  }

  .prologue-meta {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #999;
    text-transform: uppercase;
  }

  .meta-value {
    font-size: 0.88rem;
    font-weight: 500;
    color: #222;
  }

  /* Gallery Grid Rows */
  .artbook-gallery {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .spread-row {
    display: grid;
    gap: 24px;
    width: 100%;
  }

  .spread-row.grid-1 {
    grid-template-columns: 1fr;
  }

  .spread-row.grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .spread-row.grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .gallery-card {
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.2s ease;
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
    border-color: #d8d8d8;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #f4f4f6;
    overflow: hidden;
  }

  .grid-1 .card-media {
    aspect-ratio: 16 / 9;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-card:hover .card-image {
    transform: scale(1.04);
  }

  .card-hover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.5) 100%);
    opacity: 0;
    transition: opacity 0.22s ease;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 16px;
    color: #fff;
  }

  .gallery-card:hover .card-hover-overlay {
    opacity: 1;
  }

  .hover-plate {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
  }

  .hover-action {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 4px 12px;
    border-radius: 999px;
  }

  .card-info {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: #2C2C2C;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 2px 0 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.85rem;
    color: #666;
    line-height: 1.5;
    margin: 0;
  }

  .card-meta {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    color: #999;
    border-top: 1px solid #f4f4f5;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .artbook-prologue {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px;
    }
    .prologue-main {
      border-left: 0;
      border-right: 0;
      padding: 16px 0;
      border-top: 1px solid #f0f0f0;
      border-bottom: 1px solid #f0f0f0;
    }
    .prologue-meta {
      flex-direction: row;
      gap: 24px;
    }
    .spread-row.grid-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .spread-row.grid-2,
    .spread-row.grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>

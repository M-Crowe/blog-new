---
import type { ArtVolume, GalleryItem } from '../data/galleryItems';
import BookLightbox from './BookLightbox.astro';
import { siteConfig } from '../lib/config';

interface Props {
  volumes?: ArtVolume[];
  volume?: ArtVolume;
  items?: GalleryItem[];
  showVolumeHeader?: boolean;
  theme?: 'dark' | 'light';
}

const { volumes, volume, items: propsItems, showVolumeHeader = true, theme = 'dark' } = Astro.props;

const effectiveVolumes = volumes && volumes.length > 0
  ? volumes
  : (volume ? [volume] : []);

const allItems = propsItems || effectiveVolumes.flatMap((v) => v.items);
---

<div class={`gallery-wall-wrapper theme-${theme}`} id="gallery-wall-root">
  <!-- Gallery Header (Matching Reference Screenshot) -->
  <header class="gallery-main-header">
    <div class="header-left">
      <h1 class="gallery-title">画廊</h1>
      <span class="gallery-author">by {siteConfig.author.name || 'M.Crowe'}</span>
    </div>

    <div class="header-right">
      <button class="fullscreen-toggle-btn" id="gallery-fullscreen-btn" type="button" aria-label="全屏展示 (F11)" title="全屏展示">
        <svg class="icon-expand" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
        <svg class="icon-compress" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
        </svg>
      </button>
    </div>
  </header>

  <!-- Volume Selector / Filter Tabs -->
  {effectiveVolumes.length > 1 && (
    <div class="volume-nav-row">
      <div class="volume-tabs" role="tablist" aria-label="画册专题切换">
        <button class="vol-tab is-active" type="button" data-volume-tab="all" role="tab" aria-selected="true">
          全部画作 ({allItems.length})
        </button>
        {effectiveVolumes.map((vol) => (
          <button class="vol-tab" type="button" data-volume-tab={vol.volId} role="tab" aria-selected="false">
            {vol.title.split('·')[0].trim()} ({vol.items.length})
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- Volumes and Seamless Photo Grids -->
  <div class="volumes-container">
    {effectiveVolumes.map((vol) => (
      <section class="volume-section" data-volume-section={vol.volId}>
        {showVolumeHeader && (
          <div class="volume-intro-banner">
            <div class="vol-banner-left">
              <span class="vol-badge">{vol.volNumber} · {vol.year}</span>
              <h2 class="vol-heading">{vol.title}</h2>
              {vol.subtitle && <p class="vol-subheading">{vol.subtitle}</p>}
            </div>
            <div class="vol-banner-right">
              <p class="vol-curator-note">{vol.curatorNote}</p>
            </div>
          </div>
        )}

        <!-- 5-Column Seamless Photo Grid Wall (No text below images) -->
        <div class="gallery-photo-grid">
          {vol.items.map((item) => (
            <article
              class="photo-tile"
              data-open-artbook={item.id}
              data-volume-item={vol.volId}
              title={`${item.title} · 点击展卷查看大图与拍摄详情`}
            >
              <img
                src={item.image}
                alt={item.title}
                class="tile-image"
                loading="lazy"
              />
              <div class="tile-hover-mask">
                <span class="tile-plate-tag">{item.plateNumber}</span>
                <span class="tile-view-action">展卷 ↗</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- Fullscreen Book Lightbox -->
  <BookLightbox items={allItems} />
</div>

<script>
  // @ts-nocheck
  const setupGalleryWall = () => {
    const root = document.getElementById('gallery-wall-root');
    if (!root) return;

    // 1. Fullscreen Toggle API
    const fsBtn = document.getElementById('gallery-fullscreen-btn');
    if (fsBtn) {
      fsBtn.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch((err) => {
            console.warn('Fullscreen request failed:', err);
          });
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen();
          }
        }
      });

      const onFsChange = () => {
        const isFs = !!document.fullscreenElement;
        fsBtn.classList.toggle('is-fullscreen', isFs);
      };

      document.removeEventListener('fullscreenchange', onFsChange);
      document.addEventListener('fullscreenchange', onFsChange);
    }

    // 2. Volume Filter Tabs Switching
    const tabs = Array.from(root.querySelectorAll('[data-volume-tab]'));
    const sections = Array.from(root.querySelectorAll('[data-volume-section]'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetVol = tab.getAttribute('data-volume-tab');
        if (!targetVol) return;

        tabs.forEach((t) => {
          const active = t.getAttribute('data-volume-tab') === targetVol;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        sections.forEach((sec) => {
          const secVolId = sec.getAttribute('data-volume-section');
          if (targetVol === 'all' || secVolId === targetVol) {
            sec.removeAttribute('hidden');
            sec.style.display = 'block';
          } else {
            sec.setAttribute('hidden', '');
            sec.style.display = 'none';
          }
        });
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGalleryWall);
  } else {
    setupGalleryWall();
  }
  document.addEventListener('astro:page-load', setupGalleryWall);
</script>

<style>
  .gallery-wall-wrapper {
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Dark Theme Default */
  .gallery-wall-wrapper.theme-dark {
    color: #f0f0f2;
  }

  /* Gallery Main Header (Matching Reference Screenshot) */
  .gallery-main-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 0 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .gallery-main-header {
    border-bottom-color: rgba(0, 0, 0, 0.1);
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gallery-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: inherit;
    margin: 0;
    line-height: 1.2;
  }

  .gallery-author {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.04em;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .gallery-author {
    color: rgba(0, 0, 0, 0.55);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fullscreen-toggle-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: inherit;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .fullscreen-toggle-btn {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.12);
    color: #2c2c2c;
  }

  .fullscreen-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: scale(1.05);
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .fullscreen-toggle-btn:hover {
    background: rgba(0, 0, 0, 0.08);
  }

  .icon-compress {
    display: none;
  }

  .fullscreen-toggle-btn.is-fullscreen .icon-expand {
    display: none;
  }

  .fullscreen-toggle-btn.is-fullscreen .icon-compress {
    display: block;
  }

  /* Volume Filter Tabs */
  .volume-nav-row {
    display: flex;
    align-items: center;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: none;
  }

  .volume-nav-row::-webkit-scrollbar {
    display: none;
  }

  .volume-tabs {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .volume-tabs {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .vol-tab {
    background: transparent;
    border: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .vol-tab {
    color: rgba(0, 0, 0, 0.6);
  }

  .vol-tab:hover {
    color: #ffffff;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .vol-tab:hover {
    color: #000000;
  }

  .vol-tab.is-active {
    background: #ffffff;
    color: #0f1115;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .vol-tab.is-active {
    background: #111111;
    color: #ffffff;
  }

  /* Volumes Container & Intro Banner */
  .volumes-container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .volume-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .volume-intro-banner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.6fr);
    gap: 28px;
    align-items: center;
    padding: 22px 26px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .volume-intro-banner {
    background: #ffffff;
    border-color: #eaeaea;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.02);
  }

  .vol-banner-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .vol-badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #5E81AC;
    text-transform: uppercase;
  }

  .vol-heading {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: inherit;
    margin: 0;
  }

  .vol-subheading {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .vol-subheading {
    color: rgba(0, 0, 0, 0.5);
  }

  .vol-banner-right {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 24px;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .vol-banner-right {
    border-left-color: rgba(0, 0, 0, 0.08);
  }

  .vol-curator-note {
    font-size: 0.88rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .vol-curator-note {
    color: #4b5563;
  }

  /* 5-Column Seamless Photo Grid Wall */
  .gallery-photo-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 3px;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    width: 100%;
  }

  :global(body:not(.dark-gallery)) .gallery-wall-wrapper.theme-light .gallery-photo-grid {
    background: #eaeaea;
    border-color: #dcdcdc;
  }

  .photo-tile {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    cursor: pointer;
    background: #181a20;
    display: block;
    margin: 0;
    padding: 0;
  }

  .tile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  .photo-tile:hover .tile-image {
    transform: scale(1.06);
    filter: brightness(1.05);
  }

  .tile-hover-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 0%, rgba(0, 0, 0, 0.6) 100%);
    opacity: 0;
    transition: opacity 0.24s ease;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 12px;
    color: #ffffff;
    pointer-events: none;
  }

  .photo-tile:hover .tile-hover-mask {
    opacity: 1;
  }

  .tile-plate-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 3px 7px;
    border-radius: 4px;
    color: #ffffff;
  }

  .tile-view-action {
    font-size: 0.74rem;
    background: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 3px 10px;
    border-radius: 999px;
    color: #ffffff;
    font-weight: 500;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1100px) {
    .gallery-photo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .volume-intro-banner {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .vol-banner-right {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-left: 0;
      padding-top: 14px;
    }
  }

  @media (max-width: 768px) {
    .gallery-photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2px;
    }
    .gallery-title {
      font-size: 1.6rem;
    }
    .volume-intro-banner {
      padding: 16px 18px;
    }
  }

  @media (max-width: 520px) {
    .gallery-photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gallery-main-header {
      padding: 16px 0 12px;
    }
  }
</style>

---
interface Post {
  slug: string;
  title: string;
  date: Date;
  excerpt: string;
  tags: string[];
  cover: string;
}

interface GalleryItem {
  id: string;
  title: string;
  category: string;
  dateLabel: string;
  place: string;
  overlayTitle?: string;
  image: string;
  readme?: string;
}

interface Props {
  posts: Post[];
  galleryItems: GalleryItem[];
}

const { posts, galleryItems } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};
---

<div class="post-list">
  <div class="view-switcher" role="tablist" aria-label="文章视图切换">
    <button class="view-tab is-active" type="button" data-view-toggle="list" role="tab" aria-selected="true">技术文章</button>
    <button class="view-tab" type="button" data-view-toggle="gallery" role="tab" aria-selected="false">画廊视图</button>
  </div>

  <section class="view-panel" data-view-panel="gallery" aria-label="画廊视图" hidden>
    <div class="gallery-grid">
      {galleryItems.map((item, index) => (
        <article class={`gallery-card ${index === 0 ? 'gallery-card-featured' : ''}`} data-gallery-id={item.id}>
          <div class="gallery-cover-link" aria-label={`作品《${item.title}》`}>
            <img src={item.image} alt={item.title} class="gallery-cover" loading={index === 0 ? 'eager' : 'lazy'} />
            {index === 0 && (
              <div class="gallery-overlay">
                <p class="gallery-place-inline">⌖ {item.place}</p>
                <h2 class="gallery-overlay-title">{item.overlayTitle || item.title}</h2>
              </div>
            )}
          </div>
          <div class="gallery-content">
            {item.readme && (
              <a class="gallery-readme-link" href={`/gallery/${item.id}`}>README</a>
            )}
            <div class="gallery-footer">
              <span class="gallery-category">{item.category}</span>
              <span class="gallery-date">{item.dateLabel}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
    {galleryItems.length === 0 && (
      <div class="empty-state">画廊内容准备中，稍后更新。</div>
    )}
  </section>

  <section class="view-panel is-active" data-view-panel="list" aria-label="技术文章列表">
    <div class="article-list">
      {posts.map((post) => (
        <a
          class="article-row"
          href={`/posts/${post.slug}`}
          data-slug={post.slug}
          aria-label={`阅读文章《${post.title}》`}
        >
          <div class="article-row-main">
            <h2 class="article-title">
              <span>{post.title}</span>
            </h2>
            <p class="article-excerpt">{post.excerpt}</p>
            <div class="post-tags">
              {post.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
          <div class="article-row-side">
            <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
            <span class="read-more">阅读全文 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {posts.length === 0 && (
    <div class="empty-state">暂无文章，稍后会更新新内容。</div>
  )}
</div>

<script>
  const setupViewSwitcher = () => {
    const root = document.querySelector('.post-list');

    if (!root) {
      return;
    }

    const tabs = Array.from(root.querySelectorAll('[data-view-toggle]'));
    const panels = Array.from(root.querySelectorAll('[data-view-panel]'));

    const switchView = (targetView: string) => {
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-view-toggle') === targetView;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const isActive = panel.getAttribute('data-view-panel') === targetView;
        panel.classList.toggle('is-active', isActive);
        if (isActive) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetView = tab.getAttribute('data-view-toggle');
        if (targetView) {
          switchView(targetView);
        }
      });
    });
  };

  document.addEventListener('astro:page-load', setupViewSwitcher);
  setupViewSwitcher();
</script>

<style>
  .post-list {
    display: grid;
    gap: 22px;
  }

  .view-switcher {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    width: fit-content;
    border-bottom: 1px solid rgba(17, 17, 17, 0.14);
    padding-bottom: 8px;
  }

  .view-tab {
    border: 0;
    background: transparent;
    color: rgba(17, 17, 17, 0.62);
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    padding: 0 0 8px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .view-tab.is-active {
    color: #111;
    border-bottom-color: #111;
  }

  .view-panel {
    animation: panelIn 0.35s ease;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .gallery-card {
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    padding-bottom: 12px;
  }

  .gallery-card:hover {
    opacity: 0.9;
  }

  .gallery-card-featured {
    grid-column: auto;
  }

  .gallery-cover-link {
    display: block;
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
    border-radius: 10px;
  }

  .gallery-cover-link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 20%, rgba(0, 0, 0, 0.42) 100%);
  }

  .gallery-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-content {
    padding: 12px 0 0;
    display: grid;
    gap: 12px;
  }

  .gallery-readme-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0;
    border-bottom: 1px solid rgba(17, 17, 17, 0.22);
    color: rgba(17, 17, 17, 0.72);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .gallery-readme-link:hover {
    border-color: rgba(17, 17, 17, 0.5);
    color: #111;
  }

  .gallery-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 20px;
    color: #fff;
    display: grid;
    gap: 8px;
  }

  .gallery-place-inline {
    font-size: 0.95rem;
    opacity: 0.92;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .gallery-overlay-title {
    font-size: clamp(1.4rem, 2vw, 2.2rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.36);
    max-width: 12ch;
  }

  .gallery-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0;
    color: #8d95a1;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.88rem;
  }

  .gallery-category {
    font-weight: 600;
  }

  .gallery-date {
    font-size: 0.92rem;
    letter-spacing: 0.02em;
  }

  .article-list {
    display: grid;
    gap: 14px;
  }

  .article-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 22px;
    align-items: start;
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    padding: 14px 0 16px;
    transition: opacity 0.2s ease;
    color: inherit;
    text-decoration: none;
  }

  .article-row:hover {
    opacity: 0.76;
  }

  .article-row-side {
    min-width: 130px;
    display: grid;
    justify-items: end;
    gap: 10px;
  }

  .article-title {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.35;
    letter-spacing: -0.03em;
  }

  .article-title a {
    color: #111;
  }

  .article-excerpt {
    margin-top: 10px;
    color: rgba(17, 17, 17, 0.66);
  }

  .empty-state {
    border: 1px dashed rgba(17, 17, 17, 0.2);
    border-radius: 18px;
    padding: 22px;
    color: rgba(17, 17, 17, 0.6);
    text-align: center;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  time {
    font-size: 13px;
    color: rgba(17, 17, 17, 0.55);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-index {
    font-size: 12px;
    color: rgba(17, 17, 17, 0.48);
    letter-spacing: 0.16em;
  }

  .post-title {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  .post-title a {
    color: #111;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #4a4a4a;
  }

  .post-excerpt {
    margin: 14px 0 0;
    font-size: 16px;
    color: rgba(17, 17, 17, 0.66);
    line-height: 1.7;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .tag {
    display: inline-block;
    font-size: 12px;
    padding: 2px 0;
    background: transparent;
    color: rgba(17, 17, 17, 0.62);
    border: 0;
    border-bottom: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 0;
    letter-spacing: 0.04em;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    color: #111;
    border-bottom: 1px solid rgba(17, 17, 17, 0.16);
  }

  @keyframes panelIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 780px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-cover-link {
      aspect-ratio: 1 / 1.15;
    }

    .article-row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 14px 0;
    }

    .article-row-side {
      justify-items: start;
      min-width: 0;
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .post-title {
      font-size: 20px;
    }

    .gallery-content {
      padding: 10px 0 0;
    }

    .gallery-footer {
      font-size: 0.78rem;
    }

    .gallery-overlay {
      padding: 16px;
    }
  }
</style>

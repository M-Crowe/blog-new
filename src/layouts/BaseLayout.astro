---
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../lib/config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    date: Date;
    tags?: string[];
    author?: string;
  };
  currentPath?: string;
  bodyClass?: string;
  maxWidth?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description = siteConfig.site.description,
  image = siteConfig.author.avatar,
  article,
  currentPath = Astro.url.pathname,
  bodyClass = '',
  maxWidth = '1360px',
  showHeader = true,
  showFooter = true,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.site.name}` : siteConfig.site.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.site.url);
const ogImageURL = new URL(image.startsWith('http') ? image : image, Astro.site || siteConfig.site.url).toString();
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={article?.author || siteConfig.author.name} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- RSS Feed Auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.site.title}
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteConfig.site.name} />
    {article?.date && (
      <meta property="article:published_time" content={article.date.toISOString()} />
    )}
    {article?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div class="layout-container" style={`max-width: ${maxWidth}`}>
      {showHeader && <SiteHeader currentPath={currentPath} />}

      <slot />

      {showFooter && (
        <footer class="site-footer">
          <div class="footer-links">
            <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
            <a href={`mailto:${siteConfig.author.email}`}>Email</a>
            <a href="/rss.xml" target="_blank">RSS</a>
          </div>
          <p class="footer-desc">
            {siteConfig.footer.copyright}<br />
            {siteConfig.footer.desc}
          </p>
        </footer>
      )}
    </div>
  </body>
</html>

<style>
  .layout-container {
    width: 100%;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
  }

  /* Footer */
  .site-footer {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid var(--border-color);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.8;
    padding-bottom: 48px;
  }

  .footer-links {
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--text-main);
  }

  .footer-desc {
    font-size: 0.8rem;
    margin-top: 12px;
  }

  /* Dark theme overrides for Gallery */
  :global(body.dark-gallery) {
    --bg-color: #090a0d;
    --text-main: #f0f0f4;
    --text-muted: #8e94a0;
    --border-color: rgba(255, 255, 255, 0.1);
    background: #090a0d;
    color: #f0f0f4;
  }

  :global(body.dark-gallery) .site-footer {
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  :global(body.dark-gallery) .footer-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .layout-container {
      padding: 0 18px;
    }
  }
</style>

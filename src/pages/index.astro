---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { getCoverSnapshot, homepageCoverConfig } from '../lib/homepageCover';
import { galleryItems } from '../data/galleryItems';
import { siteConfig } from '../lib/config';

const currentCover = homepageCoverConfig.manualCover || '';
const coverSnapshot = getCoverSnapshot();

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formattedPosts = sortedPosts.map((post) => ({
  slug: post.id.replace(/\.md$/, ''),
  title: post.data.title,
  date: post.data.date,
  excerpt: post.data.excerpt,
  tags: post.data.tags,
  cover: post.data.cover || currentCover,
}));
---

<BaseLayout currentPath="/">
  <!-- 简介与横幅图片 -->
  <section class="hero-section">
    <h1 class="hero-intro">
      记录技术、设计与审美的交叉点。<br />
      分享前端工程化、排版与生活日常。
    </h1>

    <div class="hero-cover">
      <img
        src={currentCover}
        alt={`${siteConfig.site.name} 首页封面`}
        loading="eager"
        decoding="async"
      />
      <div class="cover-meta">
        <span data-cover-date>{coverSnapshot.gregorianDate}</span>
        <span data-cover-lunar>{coverSnapshot.lunarDate}</span>
        <span data-cover-time>{coverSnapshot.localTime}</span>
      </div>
    </div>
  </section>

  <!-- 最新文章与画集切换列表区域 -->
  <main class="main-content">
    <h2 class="section-header">Latest Posts / 最新文章</h2>
    <PostList posts={formattedPosts} galleryItems={galleryItems} />
  </main>

  <!-- 封面时间自动更新脚本 -->
  <script>
    const getSnapshot = (date = new Date()) => {
      const timeFormatter = new Intl.DateTimeFormat('zh-CN', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });
      const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      const lunarFormatter = new Intl.DateTimeFormat('zh-CN-u-ca-chinese', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });

      return {
        localTime: timeFormatter.format(date),
        gregorianDate: dateFormatter.format(date),
        lunarDate: lunarFormatter.format(date),
      };
    };

    const setupCoverTime = () => {
      const coverTime = document.querySelector('[data-cover-time]');
      const coverDate = document.querySelector('[data-cover-date]');
      const coverLunar = document.querySelector('[data-cover-lunar]');

      if (!coverTime) return;

      const renderSnapshot = () => {
        const snapshot = getSnapshot(new Date());
        if (coverTime) coverTime.textContent = snapshot.localTime;
        if (coverDate) coverDate.textContent = snapshot.gregorianDate;
        if (coverLunar) coverLunar.textContent = snapshot.lunarDate;
      };

      renderSnapshot();
      return window.setInterval(renderSnapshot, 1000);
    };

    let timerId = setupCoverTime();
    document.addEventListener('astro:page-load', () => {
      if (timerId) clearInterval(timerId);
      timerId = setupCoverTime();
    });
  </script>
</BaseLayout>

<style>
  /* 主视觉与博客简介 */
  .hero-section {
    margin: 56px 0 72px;
  }

  .hero-intro {
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-main);
    margin-bottom: 40px;
    max-width: 90%;
  }

  .hero-cover {
    position: relative;
    width: 100%;
    height: 460px;
    border-radius: var(--radius);
    overflow: hidden;
    background: #f0f0f0;
  }

  .hero-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 图片上的时间信息 */
  .cover-meta {
    position: absolute;
    bottom: 20px;
    left: 24px;
    display: flex;
    gap: 16px;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.85rem;
    font-weight: 500;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.02em;
  }

  /* 博客文章列表区域 */
  .main-content {
    margin-bottom: 80px;
  }

  .section-header {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 30px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  @media (max-width: 768px) {
    .hero-section {
      margin: 36px 0 48px;
    }
    .hero-cover {
      height: 240px;
    }
    .hero-intro {
      font-size: 1.2rem;
    }
    .cover-meta {
      flex-direction: column;
      gap: 4px;
      left: 16px;
      bottom: 16px;
    }
  }
</style>
---
import ArtBookSpread from '../../components/ArtBookSpread.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { artVolumes } from '../../data/galleryItems';
import { siteConfig } from '../../lib/config';
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>画廊 · Gallery | {siteConfig.site.name}</title>
    <style>
      :root {
        --bg-dark: #090a0d;
        --text-dark: #f0f0f4;
        --text-muted: #8e94a0;
        --border-dark: rgba(255, 255, 255, 0.1);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background: var(--bg-dark);
        color: var(--text-dark);
        -webkit-font-smoothing: antialiased;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        background: var(--bg-dark);
        color: var(--text-dark);
        line-height: 1.6;
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .gallery-viewport {
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 28px 80px;
      }

      /* Gallery Main Area */
      .gallery-main {
        margin-top: 16px;
        margin-bottom: 60px;
      }

      /* Footer */
      .site-footer {
        margin-top: 60px;
        padding-top: 30px;
        border-top: 1px solid var(--border-dark);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.8;
      }

      .footer-links {
        margin-bottom: 16px;
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--text-muted);
        transition: color 0.2s ease;
      }

      .footer-links a:hover {
        color: #ffffff;
      }

      .footer-desc {
        font-size: 0.8rem;
        margin-top: 12px;
      }

      @media (max-width: 768px) {
        .gallery-viewport {
          padding: 0 16px 60px;
        }
      }
    </style>
  </head>
  <body class="dark-gallery">
    <div class="gallery-viewport">
      <!-- 统一站点导航 -->
      <SiteHeader />

      <!-- 画廊主体（5列平铺无缝照片墙 + 顶栏 + 展开器） -->
      <main class="gallery-main">
        <ArtBookSpread volumes={artVolumes} showVolumeHeader={true} theme="dark" />
      </main>

      <!-- Footer -->
      <footer class="site-footer">
        <div class="footer-links">
          <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          <a href={`mailto:${siteConfig.author.email}`}>Email</a>
          <a href="/">返回博客</a>
        </div>
        <p class="footer-desc">
          {siteConfig.footer.copyright}<br/>
          {siteConfig.footer.desc}
        </p>
      </footer>
    </div>
  </body>
</html>

---
import type { ArtVolume, GalleryItem } from '../data/galleryItems';
import BookLightbox from './BookLightbox.astro';
import { siteConfig } from '../lib/config';

interface Props {
  volumes?: ArtVolume[];
  volume?: ArtVolume;
  items?: GalleryItem[];
  showVolumeHeader?: boolean;
  mode?: 'album' | 'wall';
}

const {
  volumes,
  volume,
  items: propsItems,
  showVolumeHeader = true,
  mode = 'album',
} = Astro.props;

const effectiveVolumes = volumes && volumes.length > 0
  ? volumes
  : (volume ? [volume] : []);

const allItems = propsItems || effectiveVolumes.flatMap((v) => v.items);

// 首页相册模式：依据作品数量智能切分行排版（1幅全宽、2幅并排、3幅并排、4幅2x2、5幅2+3）
const getVolumeRows = (items: GalleryItem[]): GalleryItem[][] => {
  const count = items.length;
  if (count <= 3) {
    return [items];
  }
  if (count === 4) {
    return [items.slice(0, 2), items.slice(2, 4)];
  }
  if (count === 5) {
    return [items.slice(0, 2), items.slice(2, 5)];
  }

  const rows: GalleryItem[][] = [];
  let idx = 0;
  while (idx < count) {
    const remaining = count - idx;
    if (remaining === 5) {
      rows.push(items.slice(idx, idx + 2));
      rows.push(items.slice(idx + 2, idx + 5));
      break;
    } else if (remaining === 4) {
      rows.push(items.slice(idx, idx + 2));
      rows.push(items.slice(idx + 2, idx + 4));
      break;
    } else if (remaining === 2) {
      rows.push(items.slice(idx, idx + 2));
      break;
    } else {
      const take = Math.min(3, remaining);
      rows.push(items.slice(idx, idx + take));
      idx += take;
    }
  }
  return rows;
};
---

{mode === 'wall' ? (
  <div class="gallery-wall-wrapper" id="gallery-wall-root">
    <header class="gallery-main-header">
      <div class="header-left">
        <h1 class="gallery-title">画廊</h1>
        <span class="gallery-author">by {siteConfig.author.name || 'M.Crowe'}</span>
      </div>

      <div class="header-right">
        <button class="fullscreen-toggle-btn" id="gallery-fullscreen-btn" type="button" aria-label="全屏展示 (F11)" title="全屏展示">
          <svg class="icon-expand" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
          </svg>
          <svg class="icon-compress" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
          </svg>
        </button>
      </div>
    </header>

    {effectiveVolumes.length > 1 && (
      <div class="volume-nav-row">
        <div class="volume-tabs" role="tablist" aria-label="画册专题切换">
          <button class="vol-tab is-active" type="button" data-volume-tab="all" role="tab" aria-selected="true">
            全部画作 ({allItems.length})
          </button>
          {effectiveVolumes.map((vol) => (
            <button class="vol-tab" type="button" data-volume-tab={vol.volId} role="tab" aria-selected="false">
              {vol.title.split('·')[0].trim()} ({vol.items.length})
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="volumes-wall-container">
      {effectiveVolumes.map((vol) => (
        <section class="wall-volume-section" data-volume-section={vol.volId}>
          {showVolumeHeader && (
            <div class="wall-intro-banner">
              <div class="wall-banner-left">
                <span class="wall-badge">{vol.volNumber} · {vol.year}</span>
                <h2 class="wall-heading">{vol.title}</h2>
                {vol.subtitle && <p class="wall-subheading">{vol.subtitle}</p>}
              </div>
              <div class="wall-banner-right">
                <p class="wall-curator-note">{vol.curatorNote}</p>
              </div>
            </div>
          )}

          <div class="wall-photo-grid">
            {vol.items.map((item) => (
              <article
                class="wall-photo-tile"
                data-open-artbook={item.id}
                title={`${item.title} · 点击展卷查看大图与拍摄详情`}
              >
                <img
                  src={item.image}
                  alt={item.title}
                  class="wall-tile-image"
                  loading="lazy"
                />
                <div class="wall-tile-mask">
                  <span class="wall-plate-tag">{item.plateNumber}</span>
                  <span class="wall-view-action">展卷 ↗</span>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <BookLightbox items={allItems} />
  </div>
) : (
  <div class="album-feed-wrapper">
    {effectiveVolumes.map((vol) => {
      const rows = getVolumeRows(vol.items);

      return (
        <article class="album-volume-card" data-volume-id={vol.volId}>
          {showVolumeHeader && (
            <header class="album-header">
              <div class="album-header-left">
                <span class="album-badge">{vol.volNumber} · {vol.year}</span>
                <h3 class="album-title">{vol.title}</h3>
                {vol.subtitle && <p class="album-subtitle">{vol.subtitle}</p>}
              </div>
              <div class="album-header-right">
                <p class="album-note">{vol.curatorNote}</p>
              </div>
            </header>
          )}

          <!-- 当前图片布局样式（纯图片网格，下方完全无字） -->
          <div class="album-grid-container">
            {rows.map((row) => (
              <div class={`album-row grid-${row.length}`}>
                {row.map((item) => (
                  <article
                    class="album-photo-card"
                    data-open-artbook={item.id}
                    title={`${item.title} · 点击展卷查看大图与拍摄详情`}
                  >
                    <div class="album-photo-media">
                      <img src={item.image} alt={item.title} class="album-photo-img" loading="lazy" />
                      <div class="album-hover-mask">
                        <span class="album-plate-num">{item.plateNumber}</span>
                        <span class="album-view-btn">展卷详情 ↗</span>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </article>
      );
    })}

    <BookLightbox items={allItems} />
  </div>
)}

<script>
  // @ts-nocheck
  const setupGalleryWallScript = () => {
    // 1. Fullscreen Toggle
    const fsBtn = document.getElementById('gallery-fullscreen-btn');
    if (fsBtn) {
      fsBtn.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch((err) => {
            console.warn('Fullscreen failed:', err);
          });
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen();
          }
        }
      });

      const onFsChange = () => {
        const isFs = !!document.fullscreenElement;
        fsBtn.classList.toggle('is-fullscreen', isFs);
      };

      document.removeEventListener('fullscreenchange', onFsChange);
      document.addEventListener('fullscreenchange', onFsChange);
    }

    // 2. Volume Tab Switching
    const root = document.getElementById('gallery-wall-root');
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll('[data-volume-tab]'));
    const sections = Array.from(root.querySelectorAll('[data-volume-section]'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetVol = tab.getAttribute('data-volume-tab');
        if (!targetVol) return;

        tabs.forEach((t) => {
          const active = t.getAttribute('data-volume-tab') === targetVol;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        sections.forEach((sec) => {
          const secVolId = sec.getAttribute('data-volume-section');
          if (targetVol === 'all' || secVolId === targetVol) {
            sec.removeAttribute('hidden');
            sec.style.display = 'block';
          } else {
            sec.setAttribute('hidden', '');
            sec.style.display = 'none';
          }
        });
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGalleryWallScript);
  } else {
    setupGalleryWallScript();
  }
  document.addEventListener('astro:page-load', setupGalleryWallScript);
</script>

<style>

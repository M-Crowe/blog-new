---
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../lib/config';
import '../styles/global.css';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group posts by year
const groupedPosts = sortedPosts.reduce((acc: Record<string, typeof sortedPosts>, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>归档 | {siteConfig.site.name}</title>
    <style>
      :root {
        --bg-color: #FAFAFB;
        --text-main: #2C2C2C;
        --text-muted: #888888;
        --text-lighter: #999999;
        --border-color: #EEEEEE;
        --radius: 12px;
        --type-nav-size: 0.95rem;
        --type-nav-spacing: 0;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background: var(--bg-color);
        -webkit-font-smoothing: antialiased;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        color: var(--text-main);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* 博客主轴容器：与首页/画集保持一致的 1360px 宽度 */
      .blog-container {
        max-width: 1360px;
        margin: 0 auto;
        padding: 0 32px;
      }

      /* 居中阅读区域 */
      .main-content {
        max-width: 800px;
        margin: 40px auto 60px;
      }

      /* Archive styles */
      .page-title {
        font-size: 2rem;
        font-weight: 500;
        margin-bottom: 40px;
        color: var(--text-main);
      }

      .archive-year-group {
        margin-bottom: 48px;
        position: relative;
      }

      .archive-year {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
      }

      .archive-list {
        list-style: none;
      }

      .archive-item {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 16px;
      }
      
      /* Hover effects inspired by PostList */
      .archive-item:hover .archive-title {
        color: var(--text-main);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
      }

      .archive-date {
        font-family: var(--font-mono, 'Monaspace Krypton', monospace);
        font-size: 0.85rem;
        color: var(--text-lighter);
        min-width: 60px;
      }

      .archive-title {
        font-size: 1.05rem;
        color: var(--text-main);
        transition: color 0.2s ease;
      }

      /* Footer */
      .site-footer {
        margin-top: 80px;
        padding-top: 30px;
        border-top: 1px solid var(--border-color);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.8;
        padding-bottom: 60px;
      }

      .footer-links {
        margin-bottom: 16px;
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--text-muted);
        transition: color 0.2s ease;
      }

      .footer-links a:hover {
        color: var(--text-main);
      }

      .footer-desc {
        font-size: 0.8rem;
        margin-top: 12px;
      }

      @media (max-width: 768px) {
        .blog-container {
          padding: 0 20px;
        }
        .archive-item {
          flex-direction: column;
          gap: 4px;
          margin-bottom: 24px;
        }
        .archive-date {
          font-size: 0.8rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="blog-container">
      <SiteHeader />

      <main class="main-content">
        <h1 class="page-title">全部文章归档</h1>
        
        {years.map(year => (
          <section class="archive-year-group">
            <h2 class="archive-year">{year}</h2>
            <ul class="archive-list">
              {groupedPosts[year].map(post => {
                const dateOutput = new Intl.DateTimeFormat('zh-CN', {
                  month: '2-digit',
                  day: '2-digit',
                }).format(post.data.date);
                
                return (
                  <li class="archive-item">
                    <span class="archive-date">{dateOutput}</span>
                    <a href={`/posts/${post.id.replace('.md', '')}`} class="archive-title">
                      {post.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          <a href={`mailto:${siteConfig.author.email}`}>Email</a>
        </div>
        <p class="footer-desc">
          {siteConfig.footer.copyright}<br/>
          {siteConfig.footer.desc}
        </p>
      </footer>
    </div>
  </body>
</html>
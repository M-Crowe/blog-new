---
import ArtBookSpread from '../../components/ArtBookSpread.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { artVolumes } from '../../data/galleryItems';
import { siteConfig } from '../../lib/config';
---

<BaseLayout
  title="画廊 · Gallery"
  description={`${siteConfig.author.name} 的摄影作品画廊展厅，收录旅行纪行与暗光花卉摄影集。`}
  currentPath="/gallery"
  bodyClass="dark-gallery"
>
  <!-- 画廊主体（5列平铺无缝照片墙 + 顶栏 + 展开器） -->
  <main class="gallery-main">
    <ArtBookSpread volumes={artVolumes} showVolumeHeader={true} mode="wall" />
  </main>
</BaseLayout>

<style>
  /* Gallery Main Area */
  .gallery-main {
    margin-top: 16px;
    margin-bottom: 60px;
  }
</style>

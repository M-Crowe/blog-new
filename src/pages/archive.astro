---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group posts by year
const groupedPosts = sortedPosts.reduce((acc: Record<string, typeof sortedPosts>, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>归档 | Marinus's Blog</title>
    <style>
      :root {
        --bg-color: #FAFAFB;
        --text-main: #2C2C2C;
        --text-muted: #888888;
        --text-lighter: #999999;
        --border-color: #EEEEEE;
        --radius: 12px;
        --type-nav-size: 0.95rem;
        --type-nav-spacing: 0;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background: var(--bg-color);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        width: 100%;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        color: var(--text-main);
        line-height: 1.6;
        overflow-x: hidden;
        width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .blog-container {
        max-width: 800px; /* More focused reading width for archive/about */
        margin: 0 auto;
        padding: 0 32px;
      }

      /* Site Header (Copied from index) */
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 40px 0;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 40px;
      }

      .site-brand {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .site-nav {
        display: flex;
        gap: 24px;
        font-size: var(--type-nav-size);
        letter-spacing: var(--type-nav-spacing);
        color: var(--text-muted);
      }

      .site-nav a:hover {
        color: var(--text-main);
      }
      
      .site-nav a.active {
        color: var(--text-main);
        font-weight: 500;
      }

      /* Archive styles */
      .page-title {
        font-size: 2rem;
        font-weight: 500;
        margin-bottom: 40px;
        color: var(--text-main);
      }

      .archive-year-group {
        margin-bottom: 48px;
        position: relative;
      }

      .archive-year {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
      }

      .archive-list {
        list-style: none;
      }

      .archive-item {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 16px;
      }
      
      /* Hover effects inspired by PostList */
      .archive-item:hover .archive-title {
        color: var(--text-main);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
      }

      .archive-date {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 0.85rem;
        color: var(--text-lighter);
        min-width: 60px;
      }

      .archive-title {
        font-size: 1.05rem;
        color: var(--text-main);
        transition: color 0.2s ease;
      }

      /* Footer */
      .site-footer {
        margin-top: 80px;
        padding-top: 30px;
        border-top: 1px solid var(--border-color);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.8;
        padding-bottom: 60px;
      }

      .footer-links {
        margin-bottom: 16px;
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--text-muted);
        transition: color 0.2s ease;
      }

      .footer-links a:hover {
        color: var(--text-main);
      }

      .footer-desc {
        font-size: 0.8rem;
        margin-top: 12px;
      }

      @media (max-width: 768px) {
        .blog-container {
          padding: 0 16px;
        }

        .site-header {
          padding: 24px 0;
          flex-direction: column;
          gap: 16px;
          align-items: flex-start;
          margin-bottom: 32px;
        }

        .site-brand {
          font-size: 1rem;
        }

        .site-nav {
          gap: 16px;
          font-size: 0.9rem;
        }

        .page-title {
          font-size: 1.5rem;
          margin-bottom: 32px;
        }

        .archive-year-group {
          margin-bottom: 36px;
        }

        .archive-year {
          font-size: 1.2rem;
          margin-bottom: 16px;
          padding-bottom: 6px;
        }

        .archive-item {
          flex-direction: column;
          gap: 4px;
          margin-bottom: 20px;
          align-items: flex-start;
        }

        .archive-date {
          font-size: 0.75rem;
          min-width: auto;
          color: var(--text-lighter);
        }

        .archive-title {
          font-size: 0.95rem;
        }

        .site-footer {
          margin-top: 60px;
          padding-top: 24px;
          padding-bottom: 40px;
          font-size: 0.8rem;
        }

        .footer-links {
          gap: 12px;
        }
      }

      @media (max-width: 480px) {
        .blog-container {
          padding: 0 12px;
        }

        .site-header {
          padding: 20px 0;
          margin-bottom: 24px;
        }

        .site-brand {
          font-size: 0.95rem;
        }

        .site-nav {
          gap: 12px;
          font-size: 0.85rem;
        }

        .page-title {
          font-size: 1.25rem;
          margin-bottom: 24px;
        }

        .archive-year-group {
          margin-bottom: 28px;
        }

        .archive-year {
          font-size: 1.1rem;
          margin-bottom: 14px;
        }

        .archive-item {
          margin-bottom: 16px;
        }

        .archive-title {
          font-size: 0.9rem;
        }

        .site-footer {
          margin-top: 48px;
          padding-top: 20px;
          padding-bottom: 32px;
          font-size: 0.75rem;
        }

        .footer-links {
          gap: 8px;
        }
      }
    </style>
  </head>
  <body>
    <div class="blog-container">
      <header class="site-header">
        <div class="site-brand"><a href="/">Marinus's Blog</a></div>
        <nav class="site-nav">
          <a href="/">首页</a>
          <a href="/gallery">画集</a>
          <a href="/archive" class="active">归档</a>
          <a href="/about">关于</a>
        </nav>
      </header>

      <main class="main-content">
        <h1 class="page-title">全部文章归档</h1>
        
        {years.map(year => (
          <section class="archive-year-group">
            <h2 class="archive-year">{year}</h2>
            <ul class="archive-list">
              {groupedPosts[year].map(post => {
                const dateOutput = new Intl.DateTimeFormat('zh-CN', {
                  month: '2-digit',
                  day: '2-digit',
                }).format(post.data.date);
                
                return (
                  <li class="archive-item">
                    <span class="archive-date">{dateOutput}</span>
                    <a href={`/posts/${post.slug}`} class="archive-title">
                      {post.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href="https://github.com/xuanyuanp/my-canvas-blog" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          <a href="mailto:contact@example.com">Email</a>
        </div>
        <p class="footer-desc">
          © 2026 Marinus's Blog. Built with Astro & Pretext.<br/>
          记录技术、设计与生活的美好时刻。
        </p>
      </footer>
    </div>
  </body>
</html>
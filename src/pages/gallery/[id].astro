---
import { galleryItems, type GalleryItem } from '../../data/galleryItems';
import '../../styles/global.css';

export async function getStaticPaths() {
  return galleryItems.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

interface Props {
  item: GalleryItem;
}

const { item } = Astro.props;

const currentIndex = galleryItems.findIndex((it) => it.id === item.id);
const prevItem = currentIndex > 0 ? galleryItems[currentIndex - 1] : null;
const nextItem = currentIndex < galleryItems.length - 1 ? galleryItems[currentIndex + 1] : null;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{item.title} · 单幅特写 | Marinus's ArtBook</title>
    <style>
      :root {
        --bg-color: #090a0d;
        --text-main: #eceff4;
        --text-muted: #94a3b8;
        --border-color: rgba(255, 255, 255, 0.08);
        --radius: 14px;
        --type-nav-size: 0.95rem;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background: var(--bg-color);
        -webkit-font-smoothing: antialiased;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        color: var(--text-main);
        line-height: 1.7;
        background: var(--bg-color);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 28px 80px;
      }

      /* Navigation Bar */
      .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 40px;
        font-size: 0.88rem;
      }

      .back-group {
        display: flex;
        gap: 16px;
        color: var(--text-muted);
      }

      .back-group a {
        transition: color 0.2s ease;
      }

      .back-group a:hover {
        color: #88c0d0;
      }

      .plate-badge {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
        font-weight: 700;
        font-size: 0.85rem;
        color: #88c0d0;
        background: rgba(136, 192, 208, 0.12);
        border: 1px solid rgba(136, 192, 208, 0.25);
        padding: 4px 10px;
        border-radius: 6px;
      }

      /* Hero Stage */
      .monograph-stage {
        background: #10121a;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
      }

      .media-box {
        position: relative;
        width: 100%;
        background: #07080c;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 24px;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
      }

      .media-image {
        max-width: 100%;
        max-height: 75vh;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 6px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
        display: block;
      }

      /* Monograph Details */
      .monograph-body {
        padding: 40px 48px;
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 48px;
      }

      .detail-main {
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .category-pill {
        display: inline-block;
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #81a1c1;
      }

      .title {
        font-size: 2.2rem;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.2;
        color: #eceff4;
        margin: 0;
      }

      .subtitle {
        font-size: 1.05rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin: -4px 0 0;
      }

      .story-quote {
        margin-top: 12px;
        font-size: 0.98rem;
        line-height: 1.85;
        color: #e2e8f0;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-left: 3px solid #88c0d0;
        padding: 16px 20px;
        border-radius: 0 8px 8px 0;
      }

      /* Aside EXIF & Meta */
      .detail-aside {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .meta-box-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .meta-box-card h3 {
        font-size: 0.76rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #81a1c1;
        margin: 0;
      }

      .info-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
      }

      .info-row .k {
        color: var(--text-muted);
      }

      .info-row .v {
        color: var(--text-main);
        font-weight: 500;
      }

      /* EXIF Grid */
      .exif-box-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 24px;
      }

      .exif-box-card h3 {
        font-size: 0.76rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #81a1c1;
        margin: 0 0 16px;
      }

      .exif-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .exif-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .exif-item .lbl {
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        color: #64748b;
      }

      .exif-item .val {
        font-size: 0.82rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
        color: #e2e8f0;
      }

      /* Footer Pagination */
      .monograph-pagination {
        margin-top: 36px;
        display: flex;
        justify-content: space-between;
        gap: 16px;
      }

      .page-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: #141722;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        font-size: 0.86rem;
        color: var(--text-main);
        transition: all 0.2s ease;
      }

      .page-btn:hover {
        background: #1c2130;
        border-color: #88c0d0;
        transform: translateY(-2px);
      }

      .page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
      }

      @media (max-width: 860px) {
        .monograph-body {
          grid-template-columns: 1fr;
          padding: 24px 20px;
          gap: 32px;
        }
        .container {
          padding: 24px 16px 60px;
        }
        .title {
          font-size: 1.7rem;
        }
      }
    </style>
  </head>
  <body>
    <main class="container">
      <nav class="top-nav">
        <div class="back-group">
          <a href="/gallery">← 返回画集</a>
          <span>·</span>
          <a href="/">博客首页</a>
        </div>
        <span class="plate-badge">{item.plateNumber}</span>
      </nav>

      <article class="monograph-stage">
        <div class="media-box">
          <img src={item.image} alt={item.title} class="media-image" />
        </div>

        <div class="monograph-body">
          <div class="detail-main">
            <span class="category-pill">{item.category}</span>
            <h1 class="title">{item.title}</h1>
            {item.subtitle && <p class="subtitle">{item.subtitle}</p>}

            <div class="story-quote">
              <p>{item.story || item.readme || '暂无作品随笔。'}</p>
            </div>
          </div>

          <aside class="detail-aside">
            <div class="meta-box-card">
              <h3>拍摄档案 / Archival Info</h3>
              <div class="info-row">
                <span class="k">地点</span>
                <span class="v">{item.place}</span>
              </div>
              <div class="info-row">
                <span class="k">时间</span>
                <span class="v">{item.dateLabel}</span>
              </div>
              <div class="info-row">
                <span class="k">分类</span>
                <span class="v">{item.category}</span>
              </div>
            </div>

            {item.exif && (
              <div class="exif-box-card">
                <h3>技术参数 / Technical EXIF</h3>
                <div class="exif-grid">
                  <div class="exif-item">
                    <span class="lbl">CAMERA</span>
                    <span class="val">{item.exif.camera || '-'}</span>
                  </div>
                  <div class="exif-item">
                    <span class="lbl">LENS</span>
                    <span class="val">{item.exif.lens || '-'}</span>
                  </div>
                  <div class="exif-item">
                    <span class="lbl">FOCAL</span>
                    <span class="val">{item.exif.focalLength || '-'}</span>
                  </div>
                  <div class="exif-item">
                    <span class="lbl">APERTURE</span>
                    <span class="val">{item.exif.aperture || '-'}</span>
                  </div>
                  <div class="exif-item">
                    <span class="lbl">SHUTTER</span>
                    <span class="val">{item.exif.shutter || '-'}</span>
                  </div>
                  <div class="exif-item">
                    <span class="lbl">ISO</span>
                    <span class="val">{item.exif.iso || '-'}</span>
                  </div>
                </div>
              </div>
            )}
          </aside>
        </div>
      </article>

      <nav class="monograph-pagination">
        {prevItem ? (
          <a href={`/gallery/${prevItem.id}`} class="page-btn">
            ← 上一幅：《{prevItem.title}》
          </a>
        ) : (
          <span class="page-btn disabled">已是第一幅</span>
        )}

        {nextItem ? (
          <a href={`/gallery/${nextItem.id}`} class="page-btn">
            下一幅：《{nextItem.title}》 →
          </a>
        ) : (
          <span class="page-btn disabled">已是最后一幅</span>
        )}
      </nav>
    </main>
  </body>
</html>


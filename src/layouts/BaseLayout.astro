---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../lib/config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    date: Date;
    tags?: string[];
    author?: string;
  };
  currentPath?: string;
  bodyClass?: string;
  maxWidth?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description = siteConfig.site.description,
  image = siteConfig.author.avatar,
  article,
  currentPath = Astro.url.pathname,
  bodyClass = '',
  maxWidth = '1360px',
  showHeader = true,
  showFooter = true,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.site.name}` : siteConfig.site.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.site.url);
const ogImageURL = new URL(image.startsWith('http') ? image : image, Astro.site || siteConfig.site.url).toString();
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={article?.author || siteConfig.author.name} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- RSS Feed Auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.site.title}
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteConfig.site.name} />
    {article?.date && (
      <meta property="article:published_time" content={article.date.toISOString()} />
    )}
    {article?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Client Router (PJAX & SPA Transitions) -->
    <ClientRouter />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div class="layout-container" style={`max-width: ${maxWidth}`}>
      {showHeader && <SiteHeader currentPath={currentPath} />}

      <slot />

      {showFooter && (
        <footer class="site-footer">
          <div class="footer-links">
            <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
            <a href={`mailto:${siteConfig.author.email}`}>Email</a>
            <a href="/rss.xml" target="_blank">RSS</a>
          </div>
          <p class="footer-desc">
            {siteConfig.footer.copyright}<br />
            {siteConfig.footer.desc}
          </p>
        </footer>
      )}
    </div>

    <!-- PJAX 路由切换全局加载指示条 -->
    <script is:inline>
      (function() {
        var pjaxBar = null;
        var pjaxTimer = null;

        function getPjaxBar() {
          if (!pjaxBar) {
            pjaxBar = document.getElementById('global-pjax-progress');
            if (!pjaxBar) {
              pjaxBar = document.createElement('div');
              pjaxBar.id = 'global-pjax-progress';
              pjaxBar.className = 'global-pjax-progress';
              pjaxBar.setAttribute('aria-hidden', 'true');
              document.body.appendChild(pjaxBar);
            }
          }
          return pjaxBar;
        }

        document.addEventListener('astro:before-preparation', function() {
          var bar = getPjaxBar();
          if (!bar) return;
          clearTimeout(pjaxTimer);
          bar.style.transition = 'none';
          bar.style.width = '0%';
          bar.style.opacity = '1';
          
          requestAnimationFrame(function() {
            bar.style.transition = 'width 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease';
            bar.style.width = '40%';
            
            pjaxTimer = setTimeout(function() {
              if (bar.style.opacity === '1') {
                bar.style.width = '75%';
              }
            }, 250);
          });
        });

        document.addEventListener('astro:after-preparation', function() {
          var bar = getPjaxBar();
          if (!bar) return;
          bar.style.width = '98%';
        });

        document.addEventListener('astro:page-load', function() {
          var bar = getPjaxBar();
          if (!bar) return;
          bar.style.width = '100%';
          setTimeout(function() {
            bar.style.opacity = '0';
            setTimeout(function() {
              bar.style.width = '0%';
            }, 250);
          }, 180);
        });
      })();
    </script>

    <!-- Pretext 全局文字排版引擎客户端脚本 -->
    <script>
      import { applyPretextTypography, cleanupPretextTypography } from '../lib/pretextTypography';

      function initTypography() {
        applyPretextTypography(document);
      }

      document.addEventListener('astro:before-swap', cleanupPretextTypography);
      document.addEventListener('astro:page-load', initTypography);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTypography);
      } else {
        initTypography();
      }
    </script>
  </body>
</html>

<style>
  .layout-container {
    width: 100%;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
  }

  /* Global PJAX Top Progress Bar */
  :global(.global-pjax-progress) {
    position: fixed;
    top: 0;
    left: 0;
    height: 2.5px;
    width: 0%;
    background: linear-gradient(90deg, #5E81AC, #88C0D0, #81A1C1);
    box-shadow: 0 0 10px rgba(94, 129, 172, 0.7);
    z-index: 1000000;
    pointer-events: none;
    opacity: 0;
  }

  /* Footer */
  .site-footer {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid var(--border-color);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.8;
    padding-bottom: 48px;
  }

  .footer-links {
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--text-main);
  }

  .footer-desc {
    font-size: 0.8rem;
    margin-top: 12px;
  }

  /* Dark theme overrides for Gallery */
  :global(body.dark-gallery) {
    --bg-color: #090a0d;
    --text-main: #f0f0f4;
    --text-muted: #8e94a0;
    --border-color: rgba(255, 255, 255, 0.1);
    background: #090a0d;
    color: #f0f0f4;
  }

  :global(body.dark-gallery) .site-footer {
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  :global(body.dark-gallery) .footer-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .layout-container {
      padding: 0 18px;
    }
  }
</style>

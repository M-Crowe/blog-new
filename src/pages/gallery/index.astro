---
import ArtBookSpread from '../../components/ArtBookSpread.astro';
import { artVolumes } from '../../data/galleryItems';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>画集 · ArtBook Monograph | Marinus's Blog</title>
    <style>
      :root {
        --bg-color: #FAFAFB;
        --text-main: #2C2C2C;
        --text-muted: #888888;
        --border-color: #EEEEEE;
        --radius: 12px;
        --type-nav-size: 0.95rem;
        --type-nav-spacing: 0;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background: var(--bg-color);
        -webkit-font-smoothing: antialiased;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        color: var(--text-main);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .blog-container {
        max-width: 1360px;
        margin: 0 auto;
        padding: 0 32px;
      }

      /* Site Header */
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 40px 0;
        border-bottom: 1px solid var(--border-color);
      }

      .site-brand {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .site-nav {
        display: flex;
        gap: 24px;
        font-size: var(--type-nav-size);
        letter-spacing: var(--type-nav-spacing);
        color: var(--text-muted);
      }

      .site-nav a:hover {
        color: var(--text-main);
      }

      .site-nav a.active {
        color: var(--text-main);
        font-weight: 600;
      }

      /* Page Banner */
      .gallery-page-header {
        margin: 48px 0 40px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 16px;
      }

      .header-title-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .page-tag {
        font-size: 0.78rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #ff5e3a;
        font-weight: 600;
      }

      .page-main-title {
        font-size: 2.4rem;
        font-weight: 600;
        letter-spacing: -0.03em;
        color: #111;
        margin: 0;
      }

      .header-desc {
        max-width: 480px;
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.6;
      }

      /* Gallery Content Container */
      .gallery-main {
        margin-bottom: 100px;
      }

      /* Footer */
      .site-footer {
        margin-top: 60px;
        padding-top: 30px;
        border-top: 1px solid var(--border-color);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.8;
        padding-bottom: 60px;
      }

      .footer-links {
        margin-bottom: 16px;
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--text-muted);
        transition: color 0.2s ease;
      }

      .footer-links a:hover {
        color: var(--text-main);
      }

      .footer-desc {
        font-size: 0.8rem;
        margin-top: 12px;
      }

      @media (max-width: 768px) {
        .blog-container {
          padding: 0 18px;
        }
        .page-main-title {
          font-size: 1.8rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="blog-container">
      <!-- 博客导航栏 -->
      <header class="site-header">
        <div class="site-brand"><a href="/">Marinus's Blog</a></div>
        <nav class="site-nav">
          <a href="/">首页</a>
          <a href="/gallery" class="active">画集</a>
          <a href="/archive">归档</a>
          <a href="/about">关于</a>
        </nav>
      </header>

      <!-- 画集头 -->
      <section class="gallery-page-header">
        <div class="header-title-group">
          <span class="page-tag">ARTBOOK & EXHIBITION</span>
          <h1 class="page-main-title">个人影集与视觉志</h1>
        </div>
        <p class="header-desc">
          探索光线在镜头与纸张之间的驻留。点击任意画幅即可进入全屏沉浸展卷模式，查看作品随笔手记与技术参数。
        </p>
      </section>

      <!-- 画集主体展区 -->
      <main class="gallery-main">
        <ArtBookSpread volumes={artVolumes} showVolumeHeader={true} />
      </main>

      <!-- Footer -->
      <footer class="site-footer">
        <div class="footer-links">
          <a href="https://github.com/M-Crowe" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          <a href="mailto:marinusCr@outlook.com">Email</a>
        </div>
        <p class="footer-desc">
          © 2026 Marinus's Blog. Built with Astro & Pretext.<br/>
          记录技术、设计与生活的美好时刻。
        </p>
      </footer>
    </div>
  </body>
</html>

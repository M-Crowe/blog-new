---
import ArtBookSpread from './ArtBookSpread.astro';
import { artVolumes, type GalleryItem } from '../data/galleryItems';

interface Post {
  slug: string;
  title: string;
  date: Date;
  excerpt: string;
  tags: string[];
  cover: string;
}

interface Props {
  posts: Post[];
  galleryItems: GalleryItem[];
}

const { posts, galleryItems } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};
---

<div class="post-list">
  <div class="view-switcher-row">
    <div class="view-switcher" role="tablist" aria-label="文章视图切换">
      <button class="view-tab is-active" type="button" data-view-toggle="list" role="tab" aria-selected="true">技术文章</button>
      <button class="view-tab" type="button" data-view-toggle="gallery" role="tab" aria-selected="false">摄影画集</button>
    </div>
  </div>

  <section class="view-panel" data-view-panel="gallery" aria-label="摄影画集视图" hidden>
    <ArtBookSpread volumes={artVolumes} showVolumeHeader={true} />
  </section>

  <section class="view-panel is-active" data-view-panel="list" aria-label="技术文章列表">
    <div class="article-list">
      {posts.map((post) => (
        <a
          class="article-row"
          href={`/posts/${post.slug}`}
          data-slug={post.slug}
          aria-label={`阅读文章《${post.title}》`}
        >
          <div class="article-row-main">
            <h2 class="article-title">
              <span>{post.title}</span>
            </h2>
            <p class="article-excerpt">{post.excerpt}</p>
            <div class="post-tags">
              {post.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
          <div class="article-row-side">
            <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
            <span class="read-more">阅读全文 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {posts.length === 0 && (
    <div class="empty-state">暂无文章，稍后会更新新内容。</div>
  )}
</div>

<script>
  const setupViewSwitcher = () => {
    const root = document.querySelector('.post-list');

    if (!root) {
      return;
    }

    const tabs = Array.from(root.querySelectorAll('[data-view-toggle]'));
    const panels = Array.from(root.querySelectorAll('[data-view-panel]'));

    const switchView = (targetView: string) => {
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-view-toggle') === targetView;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const isActive = panel.getAttribute('data-view-panel') === targetView;
        panel.classList.toggle('is-active', isActive);
        if (isActive) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetView = tab.getAttribute('data-view-toggle');
        if (targetView) {
          switchView(targetView);
        }
      });
    });
  };

  document.addEventListener('astro:page-load', setupViewSwitcher);
  setupViewSwitcher();
</script>

<style>
  .post-list {
    display: grid;
    gap: 22px;
  }

  .view-switcher-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(17, 17, 17, 0.14);
    padding-bottom: 8px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .view-switcher {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    width: fit-content;
  }

  .view-full-gallery-link {
    font-size: 0.82rem;
    color: #ff5e3a;
    letter-spacing: 0.04em;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .view-full-gallery-link:hover {
    opacity: 0.8;
  }

  .view-tab {
    border: 0;
    background: transparent;
    color: rgba(17, 17, 17, 0.62);
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    padding: 0 0 8px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .view-tab.is-active {
    color: #111;
    border-bottom-color: #111;
    font-weight: 600;
  }

  .view-panel {
    animation: panelIn 0.35s ease;
  }

  .view-panel[hidden] {
    display: none !important;
  }

  .article-list {
    display: grid;
    gap: 14px;
  }

  .article-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 22px;
    align-items: start;
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    padding: 14px 0 16px;
    transition: opacity 0.2s ease;
    color: inherit;
    text-decoration: none;
  }

  .article-row:hover {
    opacity: 0.76;
  }

  .article-row-side {
    min-width: 130px;
    display: grid;
    justify-items: end;
    gap: 10px;
  }

  .article-title {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.35;
    letter-spacing: -0.03em;
  }

  .article-title a {
    color: #111;
  }

  .article-excerpt {
    margin-top: 10px;
    color: rgba(17, 17, 17, 0.66);
  }

  .empty-state {
    border: 1px dashed rgba(17, 17, 17, 0.2);
    border-radius: 18px;
    padding: 22px;
    color: rgba(17, 17, 17, 0.6);
    text-align: center;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  time {
    font-size: 13px;
    color: rgba(17, 17, 17, 0.55);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-index {
    font-size: 12px;
    color: rgba(17, 17, 17, 0.48);
    letter-spacing: 0.16em;
  }

  .post-title {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  .post-title a {
    color: #111;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #4a4a4a;
  }

  .post-excerpt {
    margin: 14px 0 0;
    font-size: 16px;
    color: rgba(17, 17, 17, 0.66);
    line-height: 1.7;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .tag {
    display: inline-block;
    font-size: 12px;
    padding: 2px 0;
    background: transparent;
    color: rgba(17, 17, 17, 0.62);
    border: 0;
    border-bottom: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 0;
    letter-spacing: 0.04em;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    color: #111;
    border-bottom: 1px solid rgba(17, 17, 17, 0.16);
  }

  @keyframes panelIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 780px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-cover-link {
      aspect-ratio: 1 / 1.15;
    }

    .article-row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 14px 0;
    }

    .article-row-side {
      justify-items: start;
      min-width: 0;
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .post-title {
      font-size: 20px;
    }

    .gallery-content {
      padding: 10px 0 0;
    }

    .gallery-footer {
      font-size: 0.78rem;
    }

    .gallery-overlay {
      padding: 16px;
    }
  }
</style>

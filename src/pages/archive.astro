---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/config';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group posts by year
const groupedPosts = sortedPosts.reduce((acc: Record<string, typeof sortedPosts>, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="归档"
  description={`${siteConfig.site.name} 全部历史文章按年份时间线归档。`}
  currentPath="/archive"
>
  <main class="main-content">
    <h1 class="page-title">全部文章归档</h1>

    {years.map((year) => (
      <section class="archive-year-group">
        <h2 class="archive-year">{year}</h2>
        <ul class="archive-list">
          {groupedPosts[year].map((post) => {
            const dateOutput = new Intl.DateTimeFormat('zh-CN', {
              month: '2-digit',
              day: '2-digit',
            }).format(post.data.date);

            return (
              <li class="archive-item">
                <time class="archive-date" datetime={post.data.date.toISOString()}>{dateOutput}</time>
                <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="archive-title">
                  {post.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  /* 居中阅读区域 */
  .main-content {
    max-width: 800px;
    margin: 40px auto 60px;
  }

  /* Archive styles */
  .page-title {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 40px;
    color: var(--text-main);
  }

  .archive-year-group {
    margin-bottom: 48px;
    position: relative;
  }

  .archive-year {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px;
  }

  .archive-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .archive-item {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }

  .archive-item:hover .archive-title {
    color: var(--primary-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .archive-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-lighter);
    min-width: 60px;
  }

  .archive-title {
    font-size: 1.05rem;
    color: var(--text-main);
    transition: color 0.2s ease;
  }

  @media (max-width: 768px) {
    .archive-item {
      flex-direction: column;
      gap: 4px;
      margin-bottom: 24px;
    }
    .archive-date {
      font-size: 0.8rem;
    }
  }
</style>